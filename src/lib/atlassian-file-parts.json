    "bamboo:PUT /api/latest/avatar/user/avatar.png": {
      "catalog": "bamboo",
      "path": "/api/latest/avatar/user/avatar.png",
      "method": "PUT",
      "operationId": "PUT /api/latest/avatar/user/avatar.png",
      "part": "avatar",
