{
  "openapi": "3.1.0",
  "info": {
    "title": "example.com",
    "version": "1.0.0",
    "description": "Illustrative example operations for exploring methods, request inputs and workflow mappings. Executing an operation sends a real request to https://example.com and displays its response or error. The original operation identities remain compatible with saved workflows."
  },
  "paths": {
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "description": "Find projects by name and limit the number of results.",
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string",
              "title": "Project name",
              "maxLength": 80
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "title": "Result limit",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "example": [
                    {
                      "id": "project-1",
                      "name": "Documentation",
                      "status": "active"
                    }
                  ],
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        }
      ],
      "get": {
        "operationId": "getProject",
        "summary": "Get project",
        "description": "Inspect a project and its current status.",
        "tags": [
          "Projects"
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "project-1",
                    "name": "Documentation",
                    "status": "active"
                  },
                  "title": "Project",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "title": "Project ID",
                      "description": "The fictional project identifier."
                    },
                    "name": {
                      "type": "string",
                      "title": "Project name"
                    },
                    "status": {
                      "type": "string",
                      "title": "Status",
                      "enum": [
                        "active",
                        "archived"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/tasks": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        }
      ],
      "post": {
        "operationId": "createTask",
        "summary": "Create task",
        "description": "Add a task to a project with a title, priority and optional estimate.",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "task-1",
                    "projectId": "project-1",
                    "title": "Write documentation",
                    "priority": "normal",
                    "completed": false
                  },
                  "title": "Task",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "priority",
                    "completed"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "title": "Task ID",
                      "description": "The fictional task identifier."
                    },
                    "projectId": {
                      "type": "string",
                      "title": "Project ID"
                    },
                    "title": {
                      "type": "string",
                      "title": "Title"
                    },
                    "priority": {
                      "type": "string",
                      "title": "Priority",
                      "enum": [
                        "low",
                        "normal",
                        "high"
                      ]
                    },
                    "completed": {
                      "type": "boolean",
                      "title": "Completed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "title": "Task ID",
            "minLength": 1,
            "maxLength": 80
          }
        }
      ],
      "patch": {
        "operationId": "updateTask",
        "summary": "Update task",
        "description": "Change a task's title, priority or completion status.",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "title": "Title",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "priority": {
                    "type": "string",
                    "title": "Priority",
                    "enum": [
                      "low",
                      "normal",
                      "high"
                    ]
                  },
                  "completed": {
                    "type": "boolean",
                    "title": "Completed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "task-1",
                    "title": "Write documentation",
                    "priority": "high",
                    "completed": true
                  },
                  "title": "Task",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "priority",
                    "completed"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "title": "Task ID",
                      "description": "The fictional task identifier."
                    },
                    "projectId": {
                      "type": "string",
                      "title": "Project ID"
                    },
                    "title": {
                      "type": "string",
                      "title": "Title"
                    },
                    "priority": {
                      "type": "string",
                      "title": "Priority",
                      "enum": [
                        "low",
                        "normal",
                        "high"
                      ]
                    },
                    "completed": {
                      "type": "boolean",
                      "title": "Completed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
