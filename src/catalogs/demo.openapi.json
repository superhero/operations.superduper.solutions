        ],
        "parameters": [
          {
            "name": "sampleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sample ID",
              "example": "sample-1"
            }
          },
          {
            "name": "label",
            "in": "query",
            "schema": {
              "type": "string",
              "title": "Label",
              "example": "Documentation"
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "title": "Count",
              "example": 3
            }
          },
          {
            "name": "ratio",
            "in": "query",
            "schema": {
              "type": "number",
              "title": "Ratio",
              "example": 0.75
            }
          },
          {
            "name": "enabled",
            "in": "query",
            "schema": {
              "type": "boolean",
              "title": "Enabled",
              "example": true
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "title": "Priority",
              "enum": [
                "low",
                "normal",
                "high"
              ],
              "example": "normal"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "title": "Tags",
              "items": {
                "type": "string"
              },
              "example": [
                "docs",
                "example"
              ]
            }
          },
          {
            "name": "X-Example-Label",
            "in": "header",
            "schema": {
              "type": "string",
              "title": "Example header",
              "example": "workflow-example"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Illustrative response schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Echo"
