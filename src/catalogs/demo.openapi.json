    "/examples/bodies/json-object": {
      "post": {
        "operationId": "mockJsonObject",
        "summary": "Example JSON object",
        "description": "Try JSON object by sending a request to https://example.com. Includes string, integer, number, Boolean, enum, nested object, array and null properties.",
        "tags": [
          "Body formats"
        ],
        "requestBody": {
          "required": true,
          "description": "Provide a body for this example so it can be echoed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExampleObject"
              },
              "example": {
                "label": "Documentation",
                "count": 3,
                "ratio": 0.75,
                "enabled": true,
                "priority": "normal",
                "profile": {
                  "name": "Erik",
                  "count": 2
                },
                "tags": [
                  "docs",
                  "example"
                ],
                "note": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Illustrative response schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoJsonObject"
                },
                "example": {
                  "args": {},
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "json": {
                    "label": "Documentation",
                    "count": 3,
                    "ratio": 0.75,
                    "enabled": true,
                    "priority": "normal",
                    "profile": {
                      "name": "Erik",
                      "count": 2
                    },
                    "tags": [
                      "docs",
