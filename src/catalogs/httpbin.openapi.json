    "/anything/parameters/{sampleId}": {
      "get": {
        "operationId": "echoParameters",
        "summary": "HTTPBin query and header inputs",
        "description": "Echo chosen string, integer, number, Boolean, enum and array query values, a path segment and a request header. Names and input types are examples; httpbin echoes query and header values as text.",
        "tags": [
          "Input types"
        ],
        "parameters": [
          {
            "name": "sampleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sample ID",
              "example": "sample-1"
            }
          },
          {
            "name": "label",
            "in": "query",
            "schema": {
              "type": "string",
              "title": "Label",
              "example": "Documentation"
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "title": "Count",
              "example": 3
            }
          },
          {
            "name": "ratio",
            "in": "query",
            "schema": {
              "type": "number",
              "title": "Ratio",
              "example": 0.75
            }
          },
          {
            "name": "enabled",
            "in": "query",
            "schema": {
              "type": "boolean",
              "title": "Enabled",
              "example": true
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "title": "Priority",
              "enum": [
                "low",
                "normal",
                "high"
              ],
              "example": "normal"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "title": "Tags",
              "items": {
                "type": "string"
              },
              "example": [
                "docs",
                "example"
              ]
            }
          },
          {
            "name": "X-Example-Label",
            "in": "header",
            "schema": {
              "type": "string",
              "title": "Example header",
              "example": "workflow-example"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request values observed by httpbin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Echo"
                },
                "example": {
                  "args": {},
                  "headers": {},
                  "json": null,
                  "form": {},
                  "data": "",
                  "files": {},
                  "url": "https://httpbin.org/anything/parameters/{sampleId}",
                  "method": "GET",
                  "origin": "192.0.2.1"
                }
              }
            }
          }
        }
      }
    },
    "/anything/bodies/json-object": {
      "post": {
        "operationId": "echoJsonObject",
        "summary": "HTTPBin JSON object",
        "description": "Send a chosen JSON object body to httpbin. The fields and types are curated examples of arbitrary data accepted by the service. Includes string, integer, number, Boolean, enum, nested object, array and null properties.",
        "tags": [
          "Body formats"
        ],
        "requestBody": {
          "required": true,
          "description": "Provide a body for this example so it can be echoed. The live service itself accepts requests without a body.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExampleObject"
              },
              "example": {
                "label": "Documentation",
                "count": 3,
                "ratio": 0.75,
                "enabled": true,
                "priority": "normal",
                "profile": {
                  "name": "Erik",
                  "count": 2
                },
                "tags": [
                  "docs",
                  "example"
                ],
                "note": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request values observed by httpbin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoJsonObject"
                },
                "example": {
                  "args": {},
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "json": {
                    "label": "Documentation",
                    "count": 3,
                    "ratio": 0.75,
                    "enabled": true,
                    "priority": "normal",
                    "profile": {
                      "name": "Erik",
                      "count": 2
                    },
                    "tags": [
                      "docs",
                      "example"
                    ],
                    "note": null
                  },
                  "form": {},
                  "data": "{\"label\":\"Documentation\",\"count\":3,\"ratio\":0.75,\"enabled\":true,\"priority\":\"normal\",\"profile\":{\"name\":\"Erik\",\"count\":2},\"tags\":[\"docs\",\"example\"],\"note\":null}",
                  "files": {},
                  "url": "https://httpbin.org/anything/bodies/json-object",
                  "method": "POST",
                  "origin": "192.0.2.1"
                }
              }
            }
          }
        }
      }
    },
