    "/anything/methods/get": {
      "get": {
        "operationId": "echoGet",
        "summary": "HTTPBin GET request",
        "description": "Send GET to the live httpbin echo service using its /anything route.",
        "tags": [
          "HTTP methods"
        ],
        "responses": {
          "200": {
            "description": "The request values observed by httpbin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Echo"
                },
                "example": {
                  "args": {},
                  "headers": {},
                  "json": null,
                  "form": {},
                  "data": "",
                  "files": {},
                  "url": "https://httpbin.org/anything/methods/get",
                  "method": "GET",
                  "origin": "192.0.2.1"
