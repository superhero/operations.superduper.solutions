{
  "name": "@superhero/operations.superduper.solutions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json && node build.mjs",
    "test": "cucumber-js",
    "clean": "node --eval \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "coverage": "npm run build && npm run coverage:collect -- npm run test:run",
    "coverage:collect": "c8 --all --src=dist --include=dist/**/*.js --reporter=json --reporter=text-summary --reports-dir=temp/test/coverage --temp-directory=temp/test/coverage/v8",
    "test:run": "cucumber-js --config cucumber.config.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "c8": "12.0.0",
    "multiple-cucumber-html-reporter": "4.3.0",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "files": [
    "dist"
  ]
}
