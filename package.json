{
  "name": "@superhero/operations.superduper.solutions",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "badges:coverage": "bash .github/scripts/generate-coverage-badge.sh tmp/test/coverage/coverage-summary.json tmp/test/badges",
    "badges:dependencies": "bash .github/scripts/generate-dependency-badges.sh package.json .github/badges",
    "badges:scenarios": "bash .github/scripts/generate-scenario-badge.sh tmp/test/badges tmp/test/vitest-source.json tmp/test/vitest-acceptance.json tmp/test/vitest-automation.json tmp/test/vitest-browser-chromium.json tmp/test/vitest-components.json tmp/test/vitest-runner.json",
    "build": "npm run icons:check && npm run schemas:index:check && vite build",
    "dev": "vite --host 127.0.0.1",
    "report:tests": "node .github/scripts/generate-test-report.mjs",
    "test": "npm run test:acceptance",
    "test:acceptance": "node tests/gherkin/run.mjs acceptance",
    "test:automation": "node tests/gherkin/run.mjs automation",
    "test:browser": "bash .github/scripts/test-browser.sh",
    "test:coverage": "node .github/scripts/test-results.mjs coverage",
    "test:source": "node tests/gherkin/run.mjs source",
    "test:source:coverage": "OPERATIONS_COVERAGE=1 node tests/gherkin/run.mjs source",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "schemas:refresh": "node build/service-schemas.mjs && npm run schemas:index",
    "schemas:index": "node build/schema-indexes.mjs",
    "schemas:index:check": "node build/schema-indexes.mjs --check",
    "icons:generate": "node build/favicons.mjs",
    "icons:check": "node build/favicons.mjs --check",
    "test:runner": "node tests/gherkin/run.mjs runner",
    "test:components": "node tests/gherkin/run.mjs components"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@cucumber/gherkin": "32.2.0",
    "@cucumber/messages": "27.2.0",
    "@lucide/svelte": "1.52.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/papaparse": "5.5.2",
    "@visulima/dev-toolbar": "1.1.18",
    "@visulima/inspector": "2.1.0",
    "@visulima/vite-overlay": "2.0.41",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@xyflow/svelte": "1.7.0",
    "@xyflow/system": "0.0.83",
    "bits-ui": "2.19.5",
    "cn": "0.4.0",
    "flatted": "3.4.4",
    "quickpickle": "file:tests/gherkin/quickpickle",
    "sharp": "0.35.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "swagger2openapi": "7.0.8",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@isomorphic-git/lightning-fs": "4.10.3",
    "@lezer/highlight": "1.2.5",
    "@mdit/plugin-footnote": "1.1.2",
    "@mdit/plugin-img-lazyload": "1.1.2",
    "@mdit/plugin-img-size": "1.1.2",
    "@mdit/plugin-ins": "2.1.2",
    "@mdit/plugin-mark": "2.1.2",
    "@mdit/plugin-sub": "1.1.2",
    "@mdit/plugin-sup": "1.1.2",
    "@mdit/plugin-tasklist": "1.1.3",
    "@visulima/pail": "5.0.0",
    "buffer": "6.0.3",
    "hash-wasm": "4.12.0",
    "idb": "8.0.4",
    "isomorphic-git": "1.43.3",
    "markdown-it": "15.0.3",
    "papaparse": "5.7.0",
    "yaml": "2.9.1"
  }
