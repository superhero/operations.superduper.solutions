{
  "name": "@superhero/operations.superduper.solutions",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "badges:coverage": "bash .github/scripts/generate-coverage-badge.sh tmp/test/coverage/coverage-summary.json tmp/test/badges",
    "badges:dependencies": "bash .github/scripts/generate-dependency-badges.sh package.json .github/badges",
    "badges:scenarios": "bash .github/scripts/generate-scenario-badge.sh tmp/test/badges tmp/test/cucumber-source.json tmp/test/cucumber-test.json tmp/test/cucumber-automation.json tmp/test/cucumber-browser.json",
    "build": "npm run icons:check && vite build",
    "dev": "vite --host 127.0.0.1",
    "report:coverage": "node .github/scripts/generate-coverage-report.mjs tmp/test-coverage.html tmp/test/coverage",
    "report:tests": "node .github/scripts/generate-test-report.mjs tmp/test-report.html tmp/test/cucumber-source.json tmp/test/cucumber-test.json tmp/test/cucumber-automation.json tmp/test/cucumber-browser.json",
    "test": "npm run test:acceptance",
    "test:acceptance": "node --eval \"import('node:fs').then(({mkdirSync}) => mkdirSync('tmp/test', { recursive: true }))\" && cucumber-js --config cucumber.config.mjs --profile acceptance",
    "test:acceptance:coverage": "c8 --reporter=none npm --loglevel=error run test:acceptance",
    "test:automation": "cucumber-js --config cucumber.config.mjs --profile automation",
    "test:browser": "bash .github/scripts/test-browser.sh",
    "test:coverage": "c8 report --check-coverage",
    "test:source": "cucumber-js --config cucumber.config.mjs --profile source",
    "test:source:coverage": "c8 --reporter=none npm --loglevel=error run test:source",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "icons:generate": "node build/favicons.mjs",
    "icons:check": "node build/favicons.mjs --check"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@lucide/svelte": "1.52.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@visulima/dev-toolbar": "1.1.18",
    "@visulima/inspector": "2.1.0",
    "@visulima/vite-overlay": "2.0.41",
    "@xyflow/svelte": "1.7.0",
    "@xyflow/system": "0.0.83",
    "bits-ui": "2.19.5",
    "c8": "12.0.0",
    "cn": "0.4.0",
    "multiple-cucumber-html-reporter": "4.4.2",
    "sharp": "0.35.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@isomorphic-git/lightning-fs": "4.10.3",
    "@visulima/pail": "5.0.0",
    "buffer": "6.0.3",
    "hash-wasm": "4.12.0",
    "idb": "8.0.4",
    "isomorphic-git": "1.43.3",
    "yaml": "2.9.1"
  }
}
