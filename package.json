{
  "name": "@superhero/operations.superduper.solutions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:acceptance",
    "test:acceptance": "node --eval \"import('node:fs').then(({mkdirSync}) => mkdirSync('tmp/test', { recursive: true }))\" && cucumber-js --config cucumber.config.mjs",
    "test:runtime": "vitest run --config vitest.config.mjs",
    "coverage": "vitest run --config vitest.config.mjs --coverage"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.1",
    "multiple-cucumber-html-reporter": "4.3.0",
    "svelte": "5.57.1",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "files": [
    "dist"
  ]
}
