{
  "name": "@superhero/operations.superduper.solutions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:run",
    "coverage": "npm run coverage:collect -- npm run test:run",
    "coverage:collect": "c8 --all --src=src --include=src/**/*.ts --extension=.ts --reporter=json --reporter=text-summary --reports-dir=tmp/test/coverage --temp-directory=tmp/test/coverage/v8",
    "test:run": "node --eval \"import('node:fs').then(({mkdirSync}) => mkdirSync('tmp/test', { recursive: true }))\" && cucumber-js --config cucumber.config.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "c8": "12.0.0",
    "multiple-cucumber-html-reporter": "4.3.0",
    "svelte": "5.57.1",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "files": [
    "dist"
  ]
}
