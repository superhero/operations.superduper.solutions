   /**
+   * Inspect D3's exact native text prompts before submitting inference.
+   * This additive API does not post tasks, run the server loop or decode.
+   */
+  async inspectSystemOne(options: SystemOneParams): Promise<{
+    tasks: {
+      question_id: string;
+      variant: number;
+      tokens: number[];
+      input_tokens: number;
+      decoded_prompt: string;
+      token_piece_byte_lengths: number[];
+      mapping_valid: boolean;
+      fits_loaded_capacity: boolean;
+    }[];
+    diagnostics: {
+      decode_calls: number;
+      tasks_posted: number;
+      format: string;
+      text_only: boolean;
+      no_forward: boolean;
+      in_flight_readers: number;
+      in_flight_decision_requests: number;
+      queue_snapshot_has_more_tasks: boolean;
+      n_ctx: number;
+      n_batch: number;
+      n_ubatch: number;
+      publisher_max_input_tokens: number;
+      effective_max_input_tokens: number;
+    };
+  }> {
+    this.checkModelLoaded();
+    const result = await this.proxy.wllamaAction<GlueMsgGetResultRes>(
+      'inspect_systemone',
+      { _name: 'sys1_req', data_json: JSON.stringify(options) }
+    );
+    if (result.has_more || !result.data_json) {
+      throw new WllamaError('Invalid SystemOne inspection response', 'inference_error');
+    }
+    const response = this.jsonDecode(result.data_json);
+    if (!result.success || result.is_error) {
+      throw new WllamaError(
+        'SystemOne inspection: ' + (response.message || 'Unknown native error') +
+          '; native_diagnostics=' + JSON.stringify(response.diagnostics || {}),
+        'inference_error'
+      );
+    }
+    return response;
+  }
+
