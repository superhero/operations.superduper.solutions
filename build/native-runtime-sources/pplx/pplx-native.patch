+          const int64_t id = item.get<int64_t>();
+          if (id < 0 || id >= n_vocab)
+            throw std::runtime_error(std::string("Token ID outside loaded vocabulary: ") + key);
+          ids.push_back(static_cast<llama_token>(id));
+        }
+        return ids;
+      };
+      const auto tokens = token_ids("token_ids", 3, 1024);
+      const auto labels = token_ids("label_ids", 1, 255);
+      for (size_t i = 0; i < labels.size(); ++i)
