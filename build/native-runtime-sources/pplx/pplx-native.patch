+    timings: { prefill_ms: number; native_elapsed_ms: number };
+  }> {
+    this.checkModelLoaded();
+    const result = await this.proxy.wllamaAction<GlueMsgGetResultRes>(
+      'score_inline',
+      { _name: 'sys1_req', data_json: JSON.stringify(options) }
